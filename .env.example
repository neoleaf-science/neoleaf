# GitHub OAuth 2.0 configuration.
# Get these credentials at GitHub -> Settings -> Developer Settings -> OAuth Apps (https://github.com/settings/developers):
# 1. Click "New OAuth App"
# 2. Homepage URL: http://localhost:3000
# 3. Authorization callback URL: http://localhost:3000/auth/callback
# 4. Copy the Client ID and generate a Client Secret
# No GitHub account at hand? `mise run dev:fake` starts a fake GitHub and needs none of this.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3000

# Optional second provider (Codeberg, a Forgejo): it only appears on the login page when both are set.
# CODEBERG_CLIENT_ID=
# CODEBERG_CLIENT_SECRET=

# Administrators: comma-separated numeric GitHub ids (use yours; the id is at https://api.github.com/users/<login>).
# When set and not empty, only these ids are administrators and the login/e-mail rules (including ADMIN_EMAILS) are ignored.
# Without it, administrators are the logins or e-mails listed in ADMIN_EMAILS (comma-separated; they can change hands, so the server warns at startup).
# There is no built-in administrator: with neither variable set, nobody can open /admin.
# ADMIN_EMAILS=
# ADMIN_GITHUB_IDS=123456,7890123

# Key that encrypts sessions.json (AES-256-GCM), which holds the provider tokens: 32 random bytes in base64.
# Generate with: openssl rand -base64 32
# Without it, sessions live in memory only (a restart signs everybody out) and no token is written to disk.
# Changing it signs everybody out. Keep it only here, never next to sessions.json or in a backup of it.
# SESSION_KEY=

# Simultaneous sessions per person (default 8): beyond that, the person's own oldest session is ended.
# MAX_SESSIONS_PER_USER=8
